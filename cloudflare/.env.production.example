# Секреты VivaMind для Cloudflare. Скопируйте в .env.production (файл в .gitignore) и заполните.
# Загрузить в Worker: npm run secrets  (= wrangler secret bulk .env.production).
# Или задайте те же имена в дашборде: Worker -> Settings -> Variables and Secrets, тип Secret.

# OpenRouter
OPENROUTER_API_KEY=

# Neon (Postgres + pgvector): Console -> Connect. Берите хост БЕЗ "-pooler":
# Flyway и Hibernate надёжнее работают с прямым подключением, а экземпляр backend один.
DB_URL=jdbc:postgresql://ep-xxxx-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DB_USER=
DB_PASSWORD=

# R2: Cloudflare -> R2 -> Manage API tokens -> Create API token (Object Read & Write, бакет vivamind)
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Подпись JWT: длинная случайная строка, например: openssl rand -base64 48
JWT_SECRET=

# Пароли сидов: администратор (SEED_ADMIN_EMAIL) и демо-аккаунты teacher@ / student@vivamind.local
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
