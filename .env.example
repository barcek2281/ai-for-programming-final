# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Быстрая модель (ход интервью) и сильная (карточки, оценка, отчёт). Слаги — с https://openrouter.ai/models
LLM_FAST_MODEL=google/gemini-3.8-flash
LLM_STRONG_MODEL=anthropic/claude-sonnet-5.5
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIM=1024
# Фаза 2 (голос), сейчас не используется
STT_MODEL=

# DB
DB_URL=jdbc:postgresql://localhost:5432/vivamind
DB_USER=vivamind
DB_PASSWORD=vivamind

# S3 (SeaweedFS локально). Ключи должны совпадать с infra/seaweedfs/s3.json
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=vivamind
S3_SECRET_KEY=change-me-please
S3_BUCKET=vivamind

# App
JWT_SECRET=change-me-to-a-long-random-string-32-bytes-minimum
VOICE_ENABLED=false
SEED_ADMIN_EMAIL=admin@vivamind.local
SEED_ADMIN_PASSWORD=change-me
# Демо-аккаунты teacher@vivamind.local / student@vivamind.local с паролем SEED_DEMO_PASSWORD
SEED_DEMO_USERS=true
SEED_DEMO_PASSWORD=demo12345
